{
  "schema_version": 1,
  "quilt_loader": {
    "group": "${group}",
    "id": "${mod_id}",
    "version": "${mod_version}",
    "metadata": {
      "name": "${mod_name}",
      "description": "${mod_description}",
      "contributors": {
        "${mod_authors}": "Author"
      },
      "contact": {},
      "license": "${mod_license}",
      "icon": "icon.png"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "init": [
        "net.lumynity.examplemod.quilt.ExampleModQuilt"
      ]
    },
    "depends": [
      {
        "id": "quilt_loader",
        "version": ">=${quilt_loader_version}"
      },
      {
        "id": "java",
        "versions": ">=17"
      },
      {
        "id": "quilted_fabric_api",
        "version": ">=${quilt_api_version}"
      },
      {
        "id": "minecraft",
        "version": "${minecraft_version_constraint}"
      }
    ]
  },
  "mixin": [

    "examplemod-quilt.mixins.json"
  ]
}
